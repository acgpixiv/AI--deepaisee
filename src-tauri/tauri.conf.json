{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepaisee",
  "version": "0.0.21",
  "identifier": "com.deepaisee.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "deepaisee · AI 磁盘智搜",
        "width": 1420,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../models/": "models/",
      "../tools/bin/ffmpeg.exe": "tools/bin/ffmpeg.exe",
      "../onnxruntime.dll": "onnxruntime.dll",
      "../libstdc++-6.dll": "libstdc++-6.dll",
      "../libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "../libwinpthread-1.dll": "libwinpthread-1.dll",
      "../WebView2Loader.dll": "WebView2Loader.dll",
      "../.tools/cuda-runtime/": "_up_/.tools/cuda-runtime/",
      "../scripts/install-onnxruntime.ps1": "resources/scripts/install-onnxruntime.ps1",
      "../scripts/install-python-sidecar.ps1": "resources/scripts/install-python-sidecar.ps1"
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "deepaisee",
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
