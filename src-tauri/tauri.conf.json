{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deepaisee",
  "version": "0.0.20",
  "identifier": "com.deepaisee.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "deepaisee · AI 磁盘智搜",
        "width": 1420,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../.tools/onnxruntime/onnxruntime.dll",
      "../.tools/cuda-runtime/",
      "../scripts/install-onnxruntime.ps1",
      "../scripts/install-python-sidecar.ps1"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
